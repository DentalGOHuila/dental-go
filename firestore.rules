rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo estas cuentas (por UID) administran el negocio.
    // Reemplaza los dos valores por los UID de Authentication > Usuarios.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['UID_DE_ELLA', 'UID_TUYO'];
    }

    // La tienda pública solo lee este documento (sin costos ni cantidades).
    match /catalog/public {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Todo lo demás es privado.
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
